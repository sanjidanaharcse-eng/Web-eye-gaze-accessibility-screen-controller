{
  "manifest_version": 3,
  "name": "Web Eye-Gaze Accessibility Screen Controller",
  "version": "0.1.0",
  "description": "Hands-free browsing: move a cursor with your gaze, hold to click, look at the screen edges to scroll.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "action": { "default_title": "Eye-Gaze Controller", "default_popup": "popup.html", "default_icon": { "48": "icons/icon48.png", "128": "icons/icon128.png" } },
  "icons": { "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["lib/webgazer.js", "content.js"], "run_at": "document_idle" }
  ],
  "commands": {
    "toggle-pause": { "suggested_key": { "default": "Alt+Shift+G" }, "description": "Pause or resume gaze control" }
  }
}
